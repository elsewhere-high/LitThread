# Optional services. Empty values leave each service unconfigured.
# Use application settings for runtime provider credentials and relay endpoints.
# Build-time provider values are embedded in the native app; use only a gateway you control.
LITTHREAD_BUILTIN_BASE_URL=
LITTHREAD_BUILTIN_API_KEY=
LITTHREAD_BUILTIN_TRANSLATE_MODEL=
LITTHREAD_BUILTIN_EMBEDDING_MODEL=
LITTHREAD_BUILTIN_OCR_MODEL=
LITTHREAD_RELEASE_REPO=
LITTHREAD_POSTHOG_KEY=

# Export this variable in the launch environment for optional scholarly API contact.
# The application does not load runtime variables from this file automatically.
LITTHREAD_CONTACT_EMAIL=
